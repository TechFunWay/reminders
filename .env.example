# Copy this file to .env, fill in only the channels you need, then run make dev.
# Never commit the real .env file.

# SMTP email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USERNAME=your-account
# SMTP_PASSWORD=your-password-or-app-token
# SMTP_FROM_NAME=Reminder
# SMTP_FROM_ADDRESS=no-reply@example.com

# SMS provider webhook
# SMS_WEBHOOK_URL=https://sms-provider.example.com/send
# SMS_WEBHOOK_TOKEN=replace-me

# Feishu self-built app robot
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=replace-me
# FEISHU_BASE_URL=https://open.feishu.cn

# QQ bot
# QQ_BOT_APP_ID=replace-me
# QQ_BOT_APP_SECRET=replace-me
# QQ_BOT_API_BASE=https://api.bot.qq.com
